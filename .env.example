# Copy to .env and adjust. Never commit .env.

# Bearer tokens for the MCP server, as token:pseudonym pairs separated by commas.
# Pseudonyms only: no names, emails or device ids.
AAWIZ_TOKENS=demo-token-change-me:user_demo,second-token-change-me:user_b

# Where the SQLite file lives (git-ignored).
AAWIZ_DATA_DIR=./data

# Region for crisis resources: NL (default) or US.
AAWIZ_REGION=NL

# MCP server address used by the simulator.
MCP_URL=http://127.0.0.1:8000/mcp

# The token the simulator uses to talk to the MCP server.
SIM_TOKEN=demo-token-change-me

# Simulator brain: scripted (default, no key needed), llm, or nebius.
BRAIN_MODE=scripted

# Only for BRAIN_MODE=llm.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Backend: local (default, SQLite only, what judges run) or aawiz (the real Aawiz API and Elin).
BACKEND_MODE=local

# Only for BACKEND_MODE=aawiz. Log in once with: make aawiz-login (demo account only).
AAWIZ_API_BASE=https://aawiz-api.azurewebsites.net/
AAWIZ_SESSION_FILE=data/aawiz_session.json
AAWIZ_TZ=Europe/Amsterdam

# Elin's voice for the simulator (optional, any backend). Without a key the browser voice is used.
# The voice id is the public library voice "Lauren B, Friendly & Comforting Voice for AI
# Companion & Assistants"; it is not a secret. The key is.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=DODLEQrClDo8wCz460ld
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Only for BRAIN_MODE=nebius: an NVIDIA open model on Nebius Token Factory decides the tool calls.
# The key is a secret. The model id is not.
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# Hosted public demo: per-visitor synthetic users deleted after 2 hours, local backend only,
# browser speech only, and a cap on Nebius turns. Leave false on your own machine.
DEMO_PUBLIC=false
