# Copy to .env and adjust. Never commit .env.

# Bearer tokens for the MCP server, as token:pseudonym pairs separated by commas.
# Pseudonyms only: no names, emails or device ids.
AAWIZ_TOKENS=demo-token-change-me:user_demo,second-token-change-me:user_b

# Where the SQLite file lives (git-ignored).
AAWIZ_DATA_DIR=./data

# Region for crisis resources: NL (default) or US.
AAWIZ_REGION=NL

# MCP server address used by the simulator.
MCP_URL=http://127.0.0.1:8000/mcp

# The token the simulator uses to talk to the MCP server.
SIM_TOKEN=demo-token-change-me

# Simulator brain: scripted (default, no key needed) or llm.
BRAIN_MODE=scripted

# Only for BRAIN_MODE=llm.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
